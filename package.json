{
  "name": "open-spec-mesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js runtime for Open Spec Mesh first-party tools",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "open-spec-mesh": "./bin/open-spec-mesh.js"
  },
  "exports": {
    ".": "./lib/runtime/location.js",
    "./cli": "./lib/cli/registry.js",
    "./runtime/*": "./lib/runtime/*.js",
    "./documents/*": "./lib/documents/*.js"
  },
  "files": [
    "bin/open-spec-mesh.js",
    "lib/cli/*.js",
    "lib/runtime/*.js",
    "lib/documents/*.js",
    "sdd-init/scripts/*.js",
    "sdd-init/scripts/init_project.sh",
    "sdd-init/SKILL.md",
    "sdd-init/references/*.md",
    "sdd-init/templates/**/*.md",
    "sdd-init/templates/*.md",
    "sdd-init/templates/scaffold-manifest.json",
    "sdd-migrate/scripts/*.js",
    "sdd-migrate/SKILL.md",
    "sdd-migrate/references/*.md",
    "sdd-research/scripts/*.js",
    "sdd-research/SKILL.md",
    "sdd-research/references/*.md",
    "sdd-change/scripts/new_change.js",
    "sdd-change/scripts/new_change.sh",
    "sdd-change/scripts/new_task.js",
    "sdd-change/scripts/ensure_design.js",
    "sdd-change/references/*.md",
    "sdd-change/SKILL.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "jszip": "3.10.2",
    "lossless-json": "4.3.1",
    "smol-toml": "1.4.2",
    "sql.js": "1.14.2"
  },
  "scripts": {
    "test:document-tooling": "node --test tests/node/runtime/*.test.js tests/node/document-tooling/*.test.js"
  }
}
