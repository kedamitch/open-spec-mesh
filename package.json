{
  "name": "open-spec-mesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js runtime for Open Spec Mesh first-party tools",
  "engines": {
    "node": ">=24.21.0"
  },
  "bin": {
    "open-spec-mesh": "./bin/open-spec-mesh.js"
  },
  "exports": {
    ".": "./lib/runtime/location.js",
    "./cli": "./lib/cli/registry.js",
    "./runtime/*": "./lib/runtime/*.js",
    "./documents/*": "./lib/documents/*.js"
  },
  "files": [
    "bin/open-spec-mesh.js",
    "lib/**/*.js",
    "scripts/install.js",
    "scripts/host_adapter.js",
    "scripts/install_toml.js",
    "scripts/install_migrations.js",
    "scripts/install-legacy.json",
    "install.sh",
    "AGENTS.md",
    "config.toml",
    "index.md",
    "agents/*.toml",
    "agents/*.md",
    "assets/*.svg",
    "mcp/*.js",
    "mcp/*.json",
    "mcp/templates/*.json",
    "sdd-*/**/*.md",
    "sdd-*/**/*.js",
    "sdd-*/**/*.sh",
    "sdd-*/**/*.json",
    "sdd-*/**/*.yaml",
    "sdd-init/**/*.md",
    "sdd-init/**/*.js",
    "sdd-init/**/*.sh",
    "sdd-init/**/*.json",
    "sdd-migrate/**/*.md",
    "sdd-migrate/**/*.js",
    "sdd-migrate/**/*.sh",
    "sdd-migrate/**/*.json",
    "sdd-change/**/*.md",
    "sdd-change/**/*.js",
    "sdd-change/**/*.sh",
    "sdd-change/**/*.json",
    "sdd-do/**/*.md",
    "sdd-do/**/*.js",
    "sdd-do/**/*.sh",
    "sdd-do/**/*.json",
    "sdd-close/**/*.md",
    "sdd-close/**/*.js",
    "sdd-close/**/*.sh",
    "sdd-close/**/*.json",
    "sdd-research/**/*.md",
    "sdd-research/**/*.js",
    "sdd-research/**/*.sh",
    "sdd-research/**/*.json",
    "sdd-release/**/*.md",
    "sdd-release/**/*.js",
    "sdd-release/**/*.sh",
    "sdd-release/**/*.json",
    "sdd-diagnose/**/*.md",
    "sdd-diagnose/**/*.js",
    "sdd-diagnose/**/*.sh",
    "sdd-diagnose/**/*.json",
    "sdd-diagnose/**/*.yaml",
    "typesafe-laya/SKILL.md",
    "typesafe-laya/references/*.md",
    "typesafe-laya/LICENSE",
    "prd-spec/SKILL.md",
    "prd-spec/references/*.md",
    "design-overview/SKILL.md",
    "design-overview/references/*.md",
    "README.md",
    "README.zh-CN.md",
    "npm-shrinkwrap.json",
    "docs/**",
    "!docs/**/C03-task-graph.json",
    "integrations/laya-gpu/README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "jszip": "3.10.2",
    "lossless-json": "4.3.1",
    "smol-toml": "1.4.2",
    "sql.js": "1.14.2"
  },
  "scripts": {
    "test:document-tooling": "node --test tests/node/runtime/*.test.js tests/node/document-tooling/*.test.js",
    "test:agents": "node --test agents/test_validate_agents.js",
    "validate:core": "node scripts/sdd_validate.js --profile core",
    "validate:full": "node scripts/sdd_validate.js --profile full"
  }
}
